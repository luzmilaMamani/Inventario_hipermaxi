PORT=3000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_NAME=chuby_hipermaxi
DB_USER=postgres
DB_PASSWORD=tu_password

JWT_SECRET=cambia_este_secreto_por_uno_largo_y_seguro
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Google Cloud Pub/Sub (deja el topic vacío hasta configurarlo)
PUBSUB_TOPIC=
# Opcional: ruta local al JSON de la cuenta de servicio. No subas ese archivo a Git.
GOOGLE_APPLICATION_CREDENTIALS=

# Integración con Producción y Logística (vacío = desactivada)
PUBSUB_TOPIC_EVENTOS_PRODUCCION=inventario.eventos-produccion
PUBSUB_SUB_SOLICITUD_MATERIALES=inventario-solicitud-materiales
PUBSUB_SUB_PRODUCTOS_TERMINADOS=inventario-productos-terminados

# RF42: minutos entre revisiones de lotes para alertas de vencimiento (0 = desactivado)
ALERTAS_VENCIMIENTO_INTERVALO_MIN=60
