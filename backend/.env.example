PORT=3000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_NAME=chuby_hipermaxi
DB_USER=postgres
DB_PASSWORD=tu_password

JWT_SECRET=cambia_este_secreto_por_uno_largo_y_seguro
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Google Cloud Pub/Sub (deja el topic vacío hasta configurarlo)
PUBSUB_TOPIC=
# Opcional: ruta local al JSON de la cuenta de servicio. No subas ese archivo a Git.
GOOGLE_APPLICATION_CREDENTIALS=

# Suscripción exclusiva de Inventario sobre PUBSUB_TOPIC, para recibir mensajes de
# Producción y Logística (vacío = no se reciben por Pub/Sub)
PUBSUB_SUBSCRIPTION=

# RF42: minutos entre revisiones de lotes para alertas de vencimiento (0 = desactivado)
ALERTAS_VENCIMIENTO_INTERVALO_MIN=60

# RF70: envío programado de reportes por correo (SMTP). Sin SMTP_HOST los envíos
# quedan en la bitácora con error. Con Gmail: SMTP_HOST=smtp.gmail.com,
# SMTP_PORT=465, SMTP_SECURE=true y una contraseña de aplicación.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Inventario Hipermaxi <no-responder@ejemplo.com>"
# Segundos entre revisiones de reportes programados (0 = desactivado).
REPORTES_PROGRAMADOS_INTERVALO_SEG=60
