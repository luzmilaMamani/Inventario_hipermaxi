{
  "name": "chuby-hipermaxi-backend",
  "version": "1.0.0",
  "description": "API REST para el sistema de inventarios y almacen Chuby Hipermaxi.",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "migrate": "node scripts/migrate.js",
    "test": "node --test \"test/**/*.test.js\"",
    "pretest:cobertura": "node -e \"require('fs').mkdirSync('coverage', { recursive: true })\"",
    "test:cobertura": "node --test --experimental-test-coverage --test-coverage-include=src/services/** --test-coverage-include=src/utils/** --test-coverage-exclude=src/services/integracionProduccion.js --test-coverage-exclude=src/services/eventosProduccion.js --test-coverage-exclude=src/services/stockBajoPubSub.js --test-coverage-exclude=src/services/vencimientosPubSub.js --test-coverage-exclude=src/services/correo.js --test-coverage-exclude=src/services/etiquetasPdf.js --test-coverage-exclude=src/utils/migrar.js --test-coverage-exclude=src/utils/crudFactory.js --test-coverage-lines=70 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info \"test/**/*.test.js\""
  },
  "dependencies": {
    "@google-cloud/pubsub": "^6.3.1",
    "bwip-js": "^4.11.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "nodemailer": "^10.3.1",
    "pdfkit": "^0.20.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
